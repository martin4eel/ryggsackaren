{
  "name": "ryggsackaren",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ryggsäckaren - ett geografi- och frågesportspel inspirerat av Backpacker 2",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/validate-data.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-data.mjs",
    "deploy": "npm run build && node scripts/deploy-pages.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
